# 敏感信息与密钥
.env
*.key
*.pem

# 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini

# Rust 构建产物（Cargo 工作区 target 在仓库根）
/target/

# 前端依赖与构建产物
node_modules/
/dist/

# 本地发布产物（release 流程在仓库根组装便携 zip，二进制与临时目录不入库）
/Pixel-Arena_*_x64-portable.zip
/PixelArena/

# Tauri 构建时生成的 schema 与平台文件
/src-tauri/gen/schemas/

# 本地 dev 覆盖（并行开发时改 devUrl 端口用）
src-tauri/tauri.conf.dev.json

# 本地工具状态文件（约定不提交）
.zcodeignore
skills-lock.json

# 代理工具把 ~ 当字面目录建出的本地索引库（频繁读写的 sqlite，不入库）
~/

# 捆绑编码器资源（T29-4）：CI 打包前由 scripts/bundle-encoders 填充，二进制不入库
/src-tauri/resources/encoders/*
!/src-tauri/resources/encoders/README.md

# crate 许可清单（决策 0047）：cargo-about 自动生成，CI 打包前重新生成，不入库
/src-tauri/resources/notices/*
!/src-tauri/resources/notices/README.md

# archify 架构图工作目录（candidate.json、交付 HTML 与校验回执均为本地产物）
/.archify/

# 本地临时产物（截图、日志、实验文件）
/.tmp/

# Agent 本地技能目录：由 agent 工具同步/克隆（可能各自带 .git），属于本机工具，不入库
/.agents/skills/

# unipi 工具的本地配置（版本记录）
/.unipi/
